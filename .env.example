# Copy this file to .env and fill in real values. .env is git-ignored and
# never committed; this example file is committed so that anyone setting the
# project up knows which keys they need.

# Generate a fresh one per environment with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-secret-key

# True for local development, False everywhere else.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=127.0.0.1,localhost
